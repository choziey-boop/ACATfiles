.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.tip {
  padding: 24rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: #8a6d3b;
  background: #fdf6ec;
  line-height: 1.7;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-item {
  width: 48.5%;
}
