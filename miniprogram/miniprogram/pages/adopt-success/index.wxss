.page {
  min-height: 100vh;
  padding: 160rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.success-icon {
  font-size: 120rpx;
}

.success-title {
  margin-top: 32rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.success-desc {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #888888;
  text-align: center;
  line-height: 1.8;
}

.action-btn {
  margin-top: 80rpx;
  width: 100%;
  text-align: center;
}

.plain-btn {
  margin-top: 32rpx;
  color: #f2963d;
  font-size: 28rpx;
  padding: 16rpx;
}
