<view class="page">
  <view class="page-title">猫咪管理</view>

  <!-- 搜索 -->
  <view class="search-box">
    <image class="search-icon" src="/assets/search-icon.svg" mode="aspectFit" />
    <input class="search-input" placeholder="搜索猫咪名字/编号" placeholder-class="search-ph" value="{{keyword}}" bindinput="onInputKeyword" />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="onClearKeyword">×</text>
  </view>

  <!-- 筛选 -->
  <scroll-view scroll-x class="chips" enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{chips}}"
      wx:key="key"
      class="chip {{activeChip === item.key ? 'chip-on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onChipTap"
    >
      {{item.label}}{{item.key === 'all' ? '（' + total + '）' : ''}}
    </view>
  </scroll-view>

  <!-- 列表 -->
  <view wx:if="{{loading}}" class="text-muted center">加载中...</view>
  <empty wx:elif="{{cats.length === 0}}" text="还没有猫咪档案,点击下方按钮新增" />

  <view wx:else class="cat-list">
    <view class="cat-card" wx:for="{{cats}}" wx:key="_id">
      <view class="cat-left" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="onGoPhotos">
        <image class="cat-avatar" src="{{item.avatar || item.cover_image}}" mode="aspectFill" lazy-load="{{true}}" />
        <view class="cat-main">
          <text class="cat-name">{{item.name}}</text>
          <image wx:if="{{item.gender === 'male'}}" class="gender-icon" src="/assets/male.svg" mode="aspectFit" />
          <image wx:elif="{{item.gender === 'female'}}" class="gender-icon" src="/assets/female.svg" mode="aspectFit" />
        </view>
      </view>
      <view class="cat-actions">
        <view class="action-btn" data-id="{{item._id}}" catchtap="onDelete">删除</view>
        <view class="action-btn" data-id="{{item._id}}" catchtap="onEdit">编辑</view>
        <view class="action-btn" data-id="{{item._id}}" catchtap="onPublish">+动态</view>
      </view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-bar">
    <view class="pill-btn" bindtap="onAdd">新增猫咪</view>
    <view class="pill-btn" bindtap="onPublishAny">+ 动态</view>
  </view>
</view>
