.page {
  min-height: 100vh;
  padding-bottom: 180rpx;
}

/* 图片区 */
.image-wrap {
  position: relative;
  margin: 0 40rpx;
  height: 340rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.banner-image {
  width: 100%;
  height: 100%;
  display: block;
}

.image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.ph-icon {
  font-size: 60rpx;
  color: #c9cdd4;
}

.ph-text {
  font-size: 26rpx;
  color: #c9cdd4;
}

.image-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 表单项 */
.form-item {
  padding: 24rpx 40rpx;
  border-bottom: 1rpx solid #dddddd;
}

.form-label {
  font-size: 27rpx;
  color: #1d2129;
  margin-bottom: 16rpx;
}

.form-input {
  font-size: 27rpx;
  color: #1d2129;
  width: 100%;
}

.form-textarea {
  background: #f5f5f5;
  border-radius: 13rpx;
  padding: 24rpx;
  font-size: 27rpx;
  color: #1d2129;
  width: 100%;
  box-sizing: border-box;
  height: 400rpx;
}

.ph {
  color: #c9cdd4;
}

/* 底部操作:背景透明,按钮浮动 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: center;
  gap: 31rpx;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
}

.pill-btn {
  font-size: 31rpx;
  font-weight: 600;
  text-align: center;
  padding: 23rpx 44rpx;
  border-radius: 48rpx;
}

.pill-cancel {
  background: #f0f0f0;
  color: #333333;
  font-weight: 500;
}

.pill-save {
  background: #fff4dd;
  color: #ff8b26;
}

.pill-off {
  opacity: 0.5;
}
