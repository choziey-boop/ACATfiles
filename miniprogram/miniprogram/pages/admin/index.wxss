.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.center {
  padding: 200rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.deny-icon {
  font-size: 100rpx;
}

.deny-text {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.deny-sub {
  margin-top: 10rpx;
}

.menu {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}

.menu-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
}

.menu-info {
  flex: 1;
}

.menu-title {
  font-size: 32rpx;
  font-weight: 600;
}

.menu-sub {
  margin-top: 6rpx;
}

.menu-arrow {
  font-size: 48rpx;
  color: #cccccc;
}
