.page {
  min-height: 100vh;
  padding-bottom: 220rpx;
}

/* 标题:24px bold + #ffd16e 粗下划线 */
.page-title {
  padding: 20rpx 38rpx 30rpx;
}

.title-text {
  font-size: 46rpx;
  font-weight: 700;
  color: #000000;
  border-bottom: 10rpx solid #ffd16e;
  line-height: 1.15;
}

.center {
  text-align: center;
  padding: 120rpx 0;
}

/* 照片网格:80px 方块,间距 10px,一行 4 张 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 38rpx;
  margin-right: -19rpx;
}

.photo-box {
  position: relative;
  width: 154rpx;
  height: 154rpx;
  margin: 0 19rpx 19rpx 0;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 19rpx;
  background: #f1f1f1;
}

/* 角标:左下角胶囊 */
.tag {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  font-size: 23rpx;
  padding: 2rpx 17rpx;
  border-radius: 42rpx;
  line-height: 1.4;
}

.tag-cover {
  background: #e2e6ff;
  color: #004bed;
}

.tag-banner {
  background: #fffae4;
  color: #ea963d;
}

/* 编辑态选择圈:右上角 */
.check {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 29rpx;
  height: 29rpx;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
  background: rgba(0, 0, 0, 0.15);
  color: #ffffff;
  font-size: 20rpx;
  line-height: 27rpx;
  text-align: center;
  box-sizing: border-box;
}

.check-on {
  background: #e8604c;
  border-color: #e8604c;
}

/* 添加图片:虚线框 */
.photo-add {
  width: 154rpx;
  height: 154rpx;
  margin: 0 19rpx 19rpx 0;
  border: 2rpx dashed #dddddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666666;
  font-size: 21rpx;
  box-sizing: border-box;
}

/* 底部操作:居中胶囊按钮(无底板) */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
}

.pill-btn {
  background: #fff4dd;
  color: #ff8b26;
  font-size: 31rpx;
  font-weight: 700;
  text-align: center;
  padding: 23rpx 44rpx;
  border-radius: 48rpx;
  margin: 0 15rpx;
}
