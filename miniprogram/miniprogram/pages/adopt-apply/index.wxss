.page {
  min-height: 100vh;
  background: #ffffff;
  padding: 0 40rpx 40rpx;
  box-sizing: border-box;
}

/* ===== 自定义返回按钮(叠在标题左上) ===== */
.nav-back {
  position: fixed;
  left: 20rpx;
  width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.nav-back-icon {
  width: 46rpx;
  height: 46rpx;
}

/* ===== 大标题:与 about 页同款 ===== */
.page-title {
  position: relative;
  display: inline-block;
  font-size: 58rpx;
  font-weight: 700;
  color: #1d2129;
  line-height: 42rpx;
  padding: 24rpx 0 0;
  z-index: 1;
}

.page-title::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -10rpx;
  height: 10rpx;
  background: #ffb200;
  z-index: -1;
}

/* 申请对象 */
.apply-sub {
  text-align: center;
  font-size: 40rpx;
  color: #1d2129;
  padding: 40rpx 0 10rpx;
  line-height: 1.4;
}

.apply-sub-cat {
  color: #ff8b26;
}

/* ===== 表单 ===== */
.form-item {
  padding: 32rpx 0;
  background: #ffffff;
  border-bottom: 0.5rpx solid #ddd;
}

.form-item:last-of-type {
  border-bottom: none;
}

.form-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.required-star {
  color: #f53f3f;
  font-size: 28rpx;
  line-height: 1;
}

.form-label-text {
  font-size: 28rpx;
  color: #1d2129;
  line-height: 1.4;
}

.form-input {
  width: 100%;
  font-size: 32rpx;
  color: #1d2129;
  line-height: 1.4;
  padding: 0;
  box-sizing: border-box;
}

.form-placeholder {
  color: #c9cdd4;
}

.form-textarea {
  width: 100%;
  background: #f5f5f5;
  border-radius: 14rpx;
  padding: 28rpx 32rpx;
  font-size: 32rpx;
  color: #1d2129;
  height: 200rpx;
  box-sizing: border-box;
}

/* ===== 合规说明 ===== */
.notice {
  padding: 36rpx 0 20rpx;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.7;
  text-align: center;
}

/* ===== 提交按钮 ===== */
.submit-area {
  display: flex;
  justify-content: center;
  padding: 30rpx 0 20rpx;
}

.submit-btn {
  background: #fff4dd;
  border-radius: 50rpx;
  padding: 24rpx 46rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ff8b26;
  text-align: center;
}

.submit-btn-disabled {
  opacity: 0.5;
}

/* ===== 已提交状态 ===== */
.submitted-card {
  margin: 80rpx 0;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff4dd;
  border-radius: 20rpx;
}

.submitted-icon {
  font-size: 80rpx;
}

.submitted-text {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.submitted-sub {
  margin-top: 12rpx;
}
