<privacy-modal />

<view class="page">
  <!-- 自定义返回按钮:叠在标题左上方 -->
  <view class="nav-back" style="top: {{navBackTop}}px;" bindtap="onBack">
    <image class="nav-back-icon" src="/assets/back.svg" mode="aspectFit" />
  </view>

  <!-- 大标题:与 about 页同款样式;下移避开状态栏 -->
  <view class="page-title" style="margin-top: {{titleTop}}px;">领养申请</view>

  <!-- 申请对象 -->
  <view class="apply-sub">
    申请领养 <text class="apply-sub-cat">{{catName}}</text>
  </view>

  <!-- 已有待审核申请 -->
  <view wx:if="{{submitted}}" class="submitted-card">
    <view class="submitted-icon">📮</view>
    <view class="submitted-text">您已提交过申请，请勿重复提交</view>
    <view class="submitted-sub text-muted">管理员将在 3 个工作日内通过预留方式联系您</view>
  </view>

  <!-- 表单 -->
  <block wx:else>
    <!-- 联系方式 -->
    <view class="form-item">
      <view class="form-label">
        <text class="required-star">*</text>
        <text class="form-label-text">联系方式（手机号/微信号）</text>
      </view>
      <input
        class="form-input"
        placeholder="请填写，便于与您联系"
        placeholder-class="form-placeholder"
        value="{{form.contact}}"
        data-field="contact"
        bindinput="onInput"
      />
    </view>

    <!-- 领养原因 -->
    <view class="form-item">
      <view class="form-label">
        <text class="required-star">*</text>
        <text class="form-label-text">领养原因</text>
      </view>
      <textarea
        class="form-textarea"
        placeholder="简单说说为什么想领养这只猫咪"
        placeholder-class="form-placeholder"
        value="{{form.reason}}"
        data-field="reason"
        bindinput="onInput"
        maxlength="500"
      />
    </view>

    <!-- 居住情况简介 -->
    <view class="form-item">
      <view class="form-label">
        <text class="required-star">*</text>
        <text class="form-label-text">居住情况简介</text>
      </view>
      <textarea
        class="form-textarea"
        placeholder="如：自有房/合租、是否有防盗网、是否允养宠物等"
        placeholder-class="form-placeholder"
        value="{{form.living}}"
        data-field="living"
        bindinput="onInput"
        maxlength="500"
      />
    </view>

    <!-- 合规说明 -->
    <view class="notice">
      本程序为非盈利校园公益项目，收集信息仅用于领养资格审核，不涉及任何费用。
    </view>

    <!-- 提交按钮 -->
    <view class="submit-area">
      <view
        class="submit-btn {{submitting ? 'submit-btn-disabled' : ''}}"
        bindtap="onSubmit"
      >{{submitting ? '提交中...' : '提交申请'}}</view>
    </view>
  </block>
</view>
