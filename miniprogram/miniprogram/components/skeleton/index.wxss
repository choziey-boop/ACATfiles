.skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.skeleton-card {
  width: 48.5%;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.skeleton-img {
  width: 100%;
  height: 340rpx;
}

.skeleton-body {
  padding: 16rpx 20rpx 24rpx;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  margin-bottom: 14rpx;
}

.shimmer {
  background: linear-gradient(90deg, #f0ece6 25%, #faf7f2 50%, #f0ece6 75%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
}

@keyframes shimmer {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: 0 0;
  }
}
