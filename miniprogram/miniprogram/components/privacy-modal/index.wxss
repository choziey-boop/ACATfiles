.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
}

.modal-body {
  max-height: 480rpx;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
}

.contract-link {
  color: #f2963d;
  margin-top: 20rpx;
  text-decoration: underline;
}

.modal-actions {
  margin-top: 36rpx;
  display: flex;
  justify-content: space-between;
}

.btn {
  width: 46%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 44rpx;
}
.btn::after {
  border: none;
}

.btn-plain {
  background: #f2f2f2;
  color: #666666;
}

.btn-agree {
  background: #f2963d;
  color: #ffffff;
}
